# App Store Connect API key for fastlane. Copy to fastlane/.env and fill in.
# The .p8 itself is NOT stored here — keep it at ~/.appstoreconnect/private_keys/.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Optional: override the .p8 location (defaults to ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8)
# ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# Optional beta-review contact (used on the first external submission).
BETA_CONTACT_EMAIL=support@howlerops.com
BETA_CONTACT_FIRST=Oculus
BETA_CONTACT_LAST=Team
BETA_CONTACT_PHONE=0000000000
