# Oculus — TestFlight distribution via fastlane.
#
# Auth is via the App Store Connect API key (fastlane/.env — gitignored). No Apple ID /
# 2FA. Signing is Xcode-managed (automatic) using the same API key + -allowProvisioningUpdates,
# so no certificates/profiles are checked in.
#
#   cp fastlane/.env.example fastlane/.env   # fill in the 3 values (once)
#   fastlane ios bootstrap_app               # create the App Store Connect app record (once)
#   fastlane ios beta                        # build + upload to TestFlight (external)

default_platform(:ios)

APP_ID       = "com.howlerops.oculus"
XCODEPROJ    = "app/Oculus.xcodeproj"
SCHEME       = "Oculus-iOS"
TEAM_ID      = "Q6JSHJ4DQN"
KEY_ID       = ENV["ASC_KEY_ID"]
ISSUER_ID    = ENV["ASC_ISSUER_ID"]
KEY_PATH     = File.expand_path(ENV["ASC_KEY_PATH"] || "~/.appstoreconnect/private_keys/AuthKey_#{KEY_ID}.p8")

def asc_key
  app_store_connect_api_key(
    key_id: KEY_ID,
    issuer_id: ISSUER_ID,
    key_filepath: KEY_PATH,
    in_house: false,
  )
end

# xcodebuild flags that let Xcode do automatic signing against App Store Connect using
# the API key (no Apple ID login), and create any missing App IDs / profiles.
def signing_xcargs(build_number)
  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath", KEY_PATH.shellescape,
    "-authenticationKeyID", KEY_ID,
    "-authenticationKeyIssuerID", ISSUER_ID,
    "CURRENT_PROJECT_VERSION=#{build_number}",
  ].join(" ")
end

# The archive's xcargs. Just signing_xcargs — do NOT add CODE_SIGN_IDENTITY here.
#
# Pinning the identity (to force a distribution cert for an app-store archive) looks right
# and fails the build outright: the targets are CODE_SIGN_STYLE: Automatic, and Xcode
# rejects the combination — "automatically signed for development, but a conflicting code
# signing identity Apple Distribution has been manually specified". Under automatic signing
# Xcode picks the identity from the archive's configuration itself, and its choice is the
# one that works.
def archive_xcargs(build_number)
  signing_xcargs(build_number)
end

platform :ios do
  before_all do
    UI.user_error!("Set ASC_KEY_ID / ASC_ISSUER_ID in fastlane/.env (copy fastlane/.env.example).") if KEY_ID.to_s.empty? || ISSUER_ID.to_s.empty?
    UI.user_error!("API key not found at #{KEY_PATH}") unless File.exist?(KEY_PATH)
  end

  desc "Verify the App Store Connect API key authenticates and whether the app exists."
  lane :check do
    require "spaceship"
    token = Spaceship::ConnectAPI::Token.create(key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH)
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    if app
      UI.success("Authenticated ✔  App record exists: #{app.name} (#{app.bundle_id})")
    else
      UI.important("Authenticated ✔  but no app record for #{APP_ID} yet — run `fastlane ios bootstrap_app`.")
    end

    # Report the signing state a build depends on, without building. The profile count is the
    # interesting number: it should stay roughly flat. If it climbs by one per build, something
    # is changing the App ID's capabilities each run and invalidating every profile — see the
    # note in provision(), which is where that loop came from.
    bid = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == APP_ID }
    if bid
      push = Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS
      enabled = bid.get_capabilities.any? { |c| c.is_type?(push) }
      UI.message("Push Notifications on #{APP_ID}: #{enabled ? 'enabled ✔' : 'MISSING — the next build will enable it and re-cut profiles'}")
      profiles = Spaceship::ConnectAPI::Profile.all.select { |p| p.name.to_s.start_with?(APP_ID) }
      active = profiles.count { |p| p.profile_state == "ACTIVE" }
      UI.message("Profiles for #{APP_ID}: #{profiles.size} total, #{active} active, #{profiles.size - active} invalid")
      UI.important("#{profiles.size - active} invalid profiles are just clutter — safe to delete in the Developer portal.") if profiles.size - active > 10
    end
  end

  desc "Resolve signing WITHOUT building or uploading — proves a build would reuse existing profiles."
  lane :signing do
    key = asc_key
    # readonly: sigh may only find an existing valid profile, never create one. That is the whole
    # point — if this passes, the next build reuses a profile instead of cutting a fresh one, and
    # the invalid-profile pile stops growing. If it fails here, the loop described in provision()
    # is back, and it is far cheaper to learn that from this lane than from a TestFlight upload.
    get_provisioning_profile(api_key: key, app_identifier: APP_ID, readonly: true, output_path: "fastlane/build/profiles")
    get_provisioning_profile(api_key: key, app_identifier: WIDGET_ID, readonly: true, output_path: "fastlane/build/profiles")
    UI.success("Reused existing profiles ✔  #{ENV["sigh_#{APP_ID}_appstore_profile-name"]}")
  end

  desc "Register the bundle id + ensure an External Testers group (run once)."
  lane :bootstrap_app do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH)
    app_name = ENV["APP_NAME"] || "Iron Rain"

    # Register the bundle id in the Developer portal if needed (this the API DOES allow).
    unless Spaceship::ConnectAPI::BundleId.all.any? { |b| b.identifier == APP_ID }
      Spaceship::ConnectAPI::BundleId.create(name: app_name.gsub(/[^0-9A-Za-z ]/, "").strip, identifier: APP_ID, seed_id: TEAM_ID)
      UI.success("Registered bundle id #{APP_ID} in the Developer portal.")
    end

    app = Spaceship::ConnectAPI::App.find(APP_ID)
    unless app
      # The App Store Connect API does NOT allow creating app records — do it once in the UI.
      UI.important("Create the app record once in App Store Connect (the API can't):")
      UI.message("  https://appstoreconnect.apple.com  →  Apps  →  +  →  New App")
      UI.message("  Platform: iOS   Name: #{app_name}   Bundle ID: #{APP_ID}   SKU: howlerops-oculus")
      UI.message("Then re-run `fastlane ios bootstrap_app` to create the External Testers group.")
      next
    end
    UI.success("App exists: #{app.name} (#{APP_ID}).")

    begin
      if app.get_beta_groups.any? { |g| g.name == "External Testers" }
        UI.message("External Testers group already exists.")
      else
        app.create_beta_group(group_name: "External Testers", public_link_enabled: true)
        UI.success("Created 'External Testers' beta group (public link enabled).")
      end
    rescue => e
      UI.important("Couldn't auto-create the beta group (#{e.message}). Create 'External Testers' in App Store Connect → TestFlight.")
    end
  end

  desc "Validate the release archive builds + signs (no TestFlight) — de-risks `beta`."
  lane :archive_check do
    sh("cd .. && xcodegen generate --spec app/project.yml")
    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      xcargs: signing_xcargs(1),
      output_directory: "build",
      clean: true,
    )
    UI.success("Release archive + app-store signing OK — `fastlane ios beta` will upload cleanly once the app record exists.")
  end

  WIDGET_ID = "#{APP_ID}.OculusWidgets"

  # Explicitly provision (distribution cert + app-store profiles) via the API key, then
  # return the {bundle_id => profile_name} map for manual-signing export. This avoids
  # Xcode "cloud signing" which the API key can't drive.
  def provision(key)
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH)
    [APP_ID, WIDGET_ID].each do |bid|
      next if Spaceship::ConnectAPI::BundleId.all.any? { |b| b.identifier == bid }
      Spaceship::ConnectAPI::BundleId.create(name: bid.tr(".", " "), identifier: bid, seed_id: TEAM_ID, platform: "IOS")
    end
    # The app entitlement needs Push, so the App ID must have the capability before a profile
    # is cut. READ FIRST, and only write when it is genuinely missing.
    #
    # Writing it unconditionally is not the harmless no-op it looks like. Apple invalidates
    # EVERY provisioning profile for an App ID whenever that App ID's capabilities change, so
    # re-applying Push on each run invalidated the profile the previous run had just created —
    # a build would reject, as "not valid", a profile it had minted sixty seconds earlier.
    # sigh then dutifully cut a fresh one, which the next build invalidated in turn. That loop
    # is where the ~99 dead `com.howlerops.oculus AppStore <id>` profiles came from: one per
    # build, none ever reusable. The step meant to guarantee signing assets was destroying them.
    push = Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS
    app_bid = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == APP_ID }
    begin
      if app_bid.get_capabilities.any? { |c| c.is_type?(push) }
        UI.message("Push Notifications already enabled on #{APP_ID} — leaving it alone so the existing profiles stay valid.")
      else
        app_bid.create_capability(push)
        UI.important("Enabled Push Notifications on #{APP_ID}. This invalidates existing profiles; a new one will be cut.")
      end
    rescue => e
      # Never fail the build on this: if the capability really is missing, profile creation
      # fails next and says so far more precisely than we could here.
      UI.important("Could not verify the Push capability on #{APP_ID} (#{e.message}) — continuing.")
    end
    # On CI the distribution identity arrives as an imported .p12 in a throwaway keychain, so
    # point cert at it explicitly rather than trusting the search-list order. cert REUSES an
    # already-installed identity when it finds one ("Found the certificate … which is installed
    # on the local machine"); it only tries to create one when it finds none — and creating one
    # is what hits Apple's two-certificate cap and fails the build. Locally SIGNING_KEYCHAIN is
    # unset and this is exactly the call it always was.
    cert_opts = { api_key: key, output_path: "fastlane/build/certs" }
    cert_opts[:keychain_path] = ENV["SIGNING_KEYCHAIN"] if ENV["SIGNING_KEYCHAIN"].to_s != ""
    get_certificates(**cert_opts)
    get_provisioning_profile(api_key: key, app_identifier: APP_ID, output_path: "fastlane/build/profiles")
    get_provisioning_profile(api_key: key, app_identifier: WIDGET_ID, output_path: "fastlane/build/profiles")
    {
      APP_ID => ENV["sigh_#{APP_ID}_appstore_profile-name"],
      WIDGET_ID => ENV["sigh_#{WIDGET_ID}_appstore_profile-name"],
    }
  end

  # Submit the (just-uploaded, or latest) build to External Testers with the Test
  # Information Apple requires for external review.
  def testflight_external(key, distribute_only: false)
    email = ENV["BETA_CONTACT_EMAIL"] || "support@howlerops.com"
    opts = {}
    if distribute_only
      # Pin the exact build so pilot doesn't prompt (non-interactive).
      opts[:app_version] = ENV["APP_VERSION"] || "0.0.1"
      opts[:build_number] = (ENV["BUILD_NUMBER"] || latest_testflight_build_number(api_key: key, app_identifier: APP_ID)).to_s
    end
    upload_to_testflight(
      api_key: key,
      app_identifier: APP_ID,
      app_platform: "ios",
      distribute_only: distribute_only,
      distribute_external: true,
      groups: ["External Testers"],
      changelog: ENV["CHANGELOG"] || "New Iron Rain beta build.",
      notify_external_testers: true,
      beta_app_description: "Iron Rain lets you drive and approve claude-code and opencode sessions running on your Mac — from your iPhone.",
      beta_app_feedback_email: email,
      demo_account_required: false,
      uses_non_exempt_encryption: false,
      submit_beta_review: true,
      beta_app_review_info: {
        contact_first_name: ENV["BETA_CONTACT_FIRST"] || "Jacob",
        contact_last_name: ENV["BETA_CONTACT_LAST"] || "Beck",
        contact_phone: ENV["BETA_CONTACT_PHONE"] || "5555550123",
        contact_email: email,
        demo_account_required: false,
      },
      **opts,
    )
  end

  desc "Build the iOS app and upload it to TestFlight (external testers)."
  lane :beta do
    key = asc_key
    next_build = latest_testflight_build_number(
      api_key: key, app_identifier: APP_ID, initial_build_number: 0,
    ).to_i + 1

    profiles = provision(key)
    sh("cd .. && xcodegen generate --spec app/project.yml")
    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      # signing_xcargs, NOT a bare CURRENT_PROJECT_VERSION. The archive inherits
      # CODE_SIGN_STYLE: Automatic from project.yml, so on a fresh runner with no profiles
      # installed Xcode has to MINT one — which it can only do with -allowProvisioningUpdates
      # AND the API-key auth flags. Passing the version alone left it unable to sign at all
      # ("No profiles for 'com.howlerops.oculus' were found. Automatic signing is disabled"),
      # which is why this workflow had never once succeeded in CI.
      xcargs: archive_xcargs(next_build),
      output_directory: "build",
      clean: true,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: profiles,
      },
    )

    testflight_external(key)
    UI.success("Uploaded build #{next_build} + submitted to External Testers.")
  end

  desc "Distribute the latest ALREADY-uploaded build to External Testers (no rebuild)."
  lane :distribute do
    testflight_external(asc_key, distribute_only: true)
    UI.success("Submitted the latest build to External Testers.")
  end

  # Raw App Store Connect REST call using the API-key JWT (bypasses spaceship quirks).
  def asc_api(method, path, jwt, body = nil)
    require "net/http"
    require "json"
    uri = URI("https://api.appstoreconnect.apple.com#{path}")
    http = Net::HTTP.new(uri.host, 443)
    http.use_ssl = true
    klass = { get: Net::HTTP::Get, post: Net::HTTP::Post, patch: Net::HTTP::Patch }[method]
    req = klass.new(uri)
    req["Authorization"] = "Bearer #{jwt}"
    req["Content-Type"] = "application/json"
    req.body = body.to_json if body
    res = http.request(req)
    parsed = (JSON.parse(res.body) rescue res.body)
    [res.code.to_i, parsed]
  end

  desc "Set Test Information + submit the latest build for external beta review (raw ASC REST)."
  lane :submit_external do
    require "spaceship"
    token = Spaceship::ConnectAPI::Token.create(key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH)
    jwt = token.text
    email = ENV["BETA_CONTACT_EMAIL"] || "support@howlerops.com"

    # Resolve the numeric app id.
    code, apps = asc_api(:get, "/v1/apps?filter[bundleId]=#{APP_ID}", jwt)
    UI.user_error!("app lookup failed (#{code}): #{apps.inspect[0, 300]}") unless code == 200
    app_id = apps.dig("data", 0, "id")
    UI.user_error!("no app for #{APP_ID}") unless app_id
    UI.message("app id = #{app_id}")

    # 1) Beta App Review contact (required for external). Apple validates the phone is a
    # POSSIBLE number, so try well-formed candidates (env override wins).
    phones = [ENV["BETA_CONTACT_PHONE"], "+14155238880", "+12125557890", "+18005550199", "+441632960123"].compact
    ok = false
    phones.each do |phone|
      code, resp = asc_api(:patch, "/v1/betaAppReviewDetails/#{app_id}", jwt, {
        data: { type: "betaAppReviewDetails", id: app_id, attributes: {
          contactFirstName: ENV["BETA_CONTACT_FIRST"] || "Jacob",
          contactLastName:  ENV["BETA_CONTACT_LAST"]  || "Beck",
          contactPhone:     phone,
          contactEmail:     email,
          demoAccountRequired: false,
        } },
      })
      if [200, 204].include?(code)
        UI.success("Set Beta App Review contact (phone #{phone}).")
        ok = true
        break
      else
        UI.message("phone #{phone} -> #{code}: #{resp.inspect[0, 160]}")
      end
    end
    UI.user_error!("could not set a valid review-contact phone — set BETA_CONTACT_PHONE to your real number in fastlane/.env") unless ok

    # 2) Beta app localization (description + feedback email) for en-US.
    code, locs = asc_api(:get, "/v1/apps/#{app_id}/betaAppLocalizations", jwt)
    loc = (locs["data"] || []).find { |l| l.dig("attributes", "locale") == "en-US" } || (locs["data"] || []).first
    loc_attrs = {
      description: "Iron Rain lets you drive and approve claude-code and opencode sessions on your Mac from your iPhone.",
      feedbackEmail: email,
    }
    if loc
      asc_api(:patch, "/v1/betaAppLocalizations/#{loc['id']}", jwt,
              { data: { type: "betaAppLocalizations", id: loc["id"], attributes: loc_attrs } })
    else
      asc_api(:post, "/v1/betaAppLocalizations", jwt, { data: {
        type: "betaAppLocalizations", attributes: loc_attrs.merge(locale: "en-US"),
        relationships: { app: { data: { type: "apps", id: app_id } } },
      } })
    end
    UI.success("Set beta app description + feedback email.")

    # 3) Latest build → add to External Testers group + submit for external review.
    code, builds = asc_api(:get, "/v1/builds?filter[app]=#{app_id}&sort=-version&limit=1", jwt)
    build_id = builds.dig("data", 0, "id")
    UI.user_error!("no build found") unless build_id
    code, groups = asc_api(:get, "/v1/apps/#{app_id}/betaGroups", jwt)
    group_id = (groups["data"] || []).find { |g| g.dig("attributes", "name") == "External Testers" }&.dig("id")
    if group_id
      c, r = asc_api(:post, "/v1/betaGroups/#{group_id}/relationships/builds", jwt,
                     { data: [{ type: "builds", id: build_id }] })
      UI.message("add-to-group -> #{c}: #{r.inspect[0, 200]}")
    end
    code, resp = asc_api(:post, "/v1/betaAppReviewSubmissions", jwt, {
      data: { type: "betaAppReviewSubmissions",
              relationships: { build: { data: { type: "builds", id: build_id } } } },
    })
    UI.message("beta-review submission -> #{code}: #{resp.inspect[0, 300]}")
    UI.user_error!("submission failed (#{code})") unless [200, 201].include?(code)
    UI.success("Submitted build #{build_id} for external beta review 🎉")
  end

  desc "Build + upload without submitting for external review (internal testing only)."
  lane :beta_internal do
    key = asc_key
    next_build = latest_testflight_build_number(
      api_key: key, app_identifier: APP_ID, initial_build_number: 0,
    ).to_i + 1

    # Same signing as :beta — Xcode mints the archive's profile via the API key, and the
    # export uses the manual app-store profiles provision() fetched. The only difference
    # here is the internal, no-review upload.
    profiles = provision(key)
    sh("cd .. && xcodegen generate --spec app/project.yml")
    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      xcargs: archive_xcargs(next_build),
      output_directory: "build",
      clean: true,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: profiles,
      },
    )
    upload_to_testflight(api_key: key, app_identifier: APP_ID, distribute_external: false,
                         changelog: ENV["CHANGELOG"] || "New Iron Rain internal build.")
    UI.success("Uploaded build #{next_build} to internal testers (no review).")
  end
end
