# Go
/daemon/bin/
*.test
*.out

# macOS
.DS_Store

# Xcode / SwiftPM
/app/build/
/app/**/xcuserdata/
/app/**/.swiftpm/
/app/**/.build/
DerivedData/
*.xcuserstate

# Node (relay/tooling)
node_modules/

# Secrets — never commit
*.p8
.env
.env.*
/daemon/daemon

# xcodegen output (regenerate: cd app && xcodegen generate)
/app/Oculus.xcodeproj/

# OMC tooling state
.omc/
/app/Oculus/Info-iOS.plist
/app/Oculus/Info-macOS.plist
/app/OculusWidgets/Info.plist

# Allow the committed fastlane env template (real .env stays ignored)
!fastlane/.env.example

# fastlane run artifacts
fastlane/report.xml
fastlane/*.log
fastlane/test_output/
build/

# built relay binaries (use go run / fly build)
/daemon/oculus-relay
/daemon/oculus-relay-e2e
